module tb();

    reg clk=0, rst;
    
    always begin
        clk = ~clk;
        #50;
    end

    initial begin
    rst = 1'b1;   // start in reset
    #200;
    rst = 1'b0;   // release reset so CPU starts running
    #2000;
    $finish;
end

    initial begin
        $dumpfile("dump.vcd");
        $dumpvars(0);
    end

    Pipeline_top dut (.clk(clk), .rst(rst));
endmodule